+                                               "Decimal",
+                                               "Text",
+                                               "Date",
+                                               "Timestamp",
+                                               "Other"};
+            out.tuple(names[static_cast<unsigned>(key.kind_)], [&](auto& inner) {
+                std::visit(
+                    [&](const auto& value) {
+                        using T = std::decay_t<decltype(value)>;
+                        if constexpr (std::same_as<T, Timestamp>) {
+                            inner.integer(value.as_millis());
