+                [](auto& inner, const auto& entry) {
+                    write_debug(inner, entry.first);
+                    inner.raw(": ");
+                    write_debug(inner, entry.second);
+                },
+                "{",
+                "}");
+        });
+    });
+}
+
+inline void write_debug(DebugWriter& writer, const MutationPlan& value) {
