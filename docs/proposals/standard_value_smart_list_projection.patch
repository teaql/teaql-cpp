--- /dev/null
+++ b/generator/src/test/java/com/skynet/codegenerator/cpp/CppSmartListTypeProjectionTest.java
@@ -0,0 +1,52 @@
+package com.skynet.codegenerator.cpp;
+
+import static org.junit.Assert.*;
+import java.util.List;
+import org.junit.Test;
+
+public class CppSmartListTypeProjectionTest {
+  private void entity(String source) {
+    var type = CppRustLiteralMetadata.projectedEntityTypePath(source);
+    assertNotNull(source, type);
+    assertEquals(source, "Self", type.path());
+  }
+
+  @Test
+  public void smartListPreservesOwnedBorrowedAndSliceProjections() {
+    for (String source : List.of("<teaql_core::SmartList<Self> as IntoIterator>::Item",
+        "<::teaql_core::SmartList<Self> as IntoIterator>::Item",
+        "<<teaql_core::SmartList<Self> as IntoIterator>::IntoIter as Iterator>::Item",
+        "<<&teaql_core::SmartList<Self> as IntoIterator>::Item as std::ops::Deref>::Target",
+        "<<&mut teaql_core::SmartList<Self> as IntoIterator>::Item as std::ops::Deref>::Target",
+        "<<<teaql_core::SmartList<Self> as std::ops::Deref>::Target as ToOwned>::Owned as IntoIterator>::Item")) {
+      entity(source);
+    }
+  }
+
+  @Test
+  public void nestedSmartListValuesRetainCloneAndSizedRequirements() {
+    for (String error : List.of("teaql_core::SmartList<Self>", "teaql_core::SmartList<String>",
+        "teaql_core::SmartList<[Self; 1]>")) {
+      entity("<<Result<Self, " + error + "> as ToOwned>::Owned as IntoIterator>::Item");
+    }
+    entity("<Result<Self, teaql_core::SmartList<&mut Self>> as IntoIterator>::Item");
+    for (String source : List.of(
+        "<<Result<Self, teaql_core::SmartList<&mut Self>> as ToOwned>::Owned as IntoIterator>::Item",
+        "<Result<Self, teaql_core::SmartList<str>> as IntoIterator>::Item")) {
+      assertNull(source, CppRustLiteralMetadata.projectedEntityTypePath(source));
+    }
+  }
+
+  @Test
+  public void smartListUsesThePublicRuntimeExportAndModeledElementScope() {
+    var type = CppRustLiteralMetadata.projectedEntityTypePath(
+        "<Result<Self, teaql_core::SmartList<crate::child::Child>> as IntoIterator>::Item");
+    assertNotNull(type);
+    assertEquals(List.of("Self", "crate::child::Child"), type.requiredEntityPaths());
+    for (String source : List.of("<SmartList<Self> as IntoIterator>::Item",
+        "<teaql_core::list::SmartList<Self> as IntoIterator>::Item",
+        "<teaql_core::UnknownList<Self> as IntoIterator>::Item")) {
+      assertNull(source, CppRustLiteralMetadata.projectedEntityTypePath(source));
+    }
+  }
+}
