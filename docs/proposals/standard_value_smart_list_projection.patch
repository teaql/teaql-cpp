+++ b/generator/src/test/java/com/skynet/codegenerator/cpp/CppStandardValueTypeProjectionTest.java
@@ -0,0 +1,69 @@
+package com.skynet.codegenerator.cpp;
+
+import static org.junit.Assert.*;
+import java.util.List;
+import org.junit.Test;
+
+public class CppStandardValueTypeProjectionTest {
+  private void entity(String source) {
+    var type = CppRustLiteralMetadata.projectedEntityTypePath(source);
+    assertNotNull(source, type);
+    assertEquals(source, "Self", type.path());
+  }
+
+  @Test
+  public void ownedAndBorrowedStringErrorsRemainStandardValues() {
+    for (String error : List.of("String", "std::string::String", "::std::string::String",
+        "&str", "&core::primitive::str", "<str as ToOwned>::Owned", "Box<str>")) {
+      entity("<Result<Self, " + error + "> as IntoIterator>::Item");
+    }
+  }
+
+  @Test
+  public void arraysAndBorrowedSlicesExposeTheirEntityItems() {
+    for (String source : List.of("<[Self; 1] as IntoIterator>::Item",
+        "<<[Self; 0] as IntoIterator>::IntoIter as Iterator>::Item",
+        "<std::array::IntoIter<Self, 2> as Iterator>::Item",
+        "<<&[Self] as IntoIterator>::Item as std::ops::Deref>::Target",
+        "<<&[Self; 2] as IntoIterator>::Item as std::ops::Deref>::Target",
+        "<<[Self] as ToOwned>::Owned as IntoIterator>::Item")) {
+      entity(source);
+    }
+  }
+
+  @Test
+  public void valueShapeControlsRecursiveCloningAndSizing() {
+    for (String error : List.of("String", "Box<str>", "[Self; 1]", "&[Self]", "Box<[Self]>")) {
+      entity("<<Result<Self, " + error + "> as ToOwned>::Owned as IntoIterator>::Item");
+    }
+    for (String error : List.of("str", "[Self]", "[str; 1]", "[&mut Self; 1]", "&mut str")) {
+      assertNull(error, CppRustLiteralMetadata.projectedEntityTypePath(
+          "<<Result<Self, " + error + "> as ToOwned>::Owned as IntoIterator>::Item"));
+    }
+  }
+
+  @Test
+  public void arrayLengthLiteralsPreserveUsizeAndScopeRequirements() {
+    for (String length : List.of("0", "1usize", "0x2", "0b10usize", "0o2", "1_0usize")) {
+      entity("<[Self; " + length + "] as IntoIterator>::Item");
+    }
+    for (String length : List.of("MissingLength", "1u8", "1.0", "-1", "18446744073709551616usize",
+        "0b2", "0x")) {
+      assertNull(length, CppRustLiteralMetadata.projectedEntityTypePath(
+          "<[Self; " + length + "] as IntoIterator>::Item"));
+    }
+  }
+
+  @Test
+  public void erasedStandardValuesKeepModeledScopeRequirements() {
+    var type = CppRustLiteralMetadata.projectedEntityTypePath(
+        "<Result<Self, [crate::child::Child; 1]> as IntoIterator>::Item");
+    assertNotNull(type);
+    assertEquals(List.of("Self", "crate::child::Child"), type.requiredEntityPaths());
+    for (String source : List.of("String", "str", "[Self]", "[Self; 1]",
+        "<String as ToOwned>::Owned", "<String as IntoIterator>::Item",
+        "<[Self] as IntoIterator>::Item")) {
+      assertNull(source, CppRustLiteralMetadata.projectedEntityTypePath(source));
+    }
+  }
+}
