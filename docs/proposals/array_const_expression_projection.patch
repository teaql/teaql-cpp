+package com.skynet.codegenerator.cpp;
+
+import static org.junit.Assert.*;
+import java.util.List;
+import org.junit.Test;
+
+public class CppArrayConstExpressionProjectionTest {
+  private void length(String source) {
+    var type = CppRustLiteralMetadata.projectedEntityTypePath(
+        "<[Self; " + source + "] as IntoIterator>::Item");
+    assertNotNull(source, type);
+    assertEquals(source, "Self", type.path());
+  }
+
+  private void refused(String source) {
+    assertNull(source, CppRustLiteralMetadata.projectedEntityTypePath(
+        "<[Self; " + source + "] as IntoIterator>::Item"));
+  }
+
+  @Test
+  public void arithmeticPreservesRustPrecedenceAndGrouping() {
+    for (String source : List.of("1 + 1", "1 + 2 * 3", "(1 + 2) * 2", "{1 + 1}",
+        "8 / 4", "8 % 3", "1 << 2", "(1 | 2) & 3", "/* lhs */1 + /* rhs */1")) {
+      length(source);
+    }
+  }
+
+  @Test
+  public void integerTypesAndCastsKeepTheirOwnBounds() {
+    for (String source : List.of("(1u8 + 1u8) as usize",
+        "(-128i8 + 127i8 + 2i8) as usize", "(257u16 as u8) as usize",
+        "((128u8 << 1) as usize) + 1")) {
+      length(source);
+    }
+    for (String source : List.of("(255u8 + 1u8) as usize", "0usize - 1", "1 / 0",
+        "1u8 + 1u8", "(-1u8) as usize", "1usize << 64", "1USIZE", "1 as USIZE")) {
+      refused(source);
+    }
+  }
+
+  @Test
+  public void localBindingsRetainInferenceShadowingAndMutation() {
+    for (String source : List.of("{let count = 1; count + 1}",
+        "{let count: u8 = 1; count as usize}",
+        "{let count = 1usize; let count = count + 1; count}",
+        "{let mut count = 1usize; count += 1; count}",
+        "{let selected = true; if selected {1} else {2}}")) {
+      length(source);
+    }
+  }
+
+  @Test
+  public void conditionalExecutionStillChecksBothBranchTypes() {
+    length("{if true {1} else {1 / 0}}");
+    length("{if false && (1usize / 0 == 0) {2} else {1}}");
+    length("{if true || (1usize / 0 == 0) {1} else {2}}");
+    refused("{if true {1usize} else {1u8}}");
+    refused("{let unused = 1usize / 0; 1}");
+  }
+
+  @Test
+  public void unknownOrInvalidLocalScopeCannotBeErased() {
+    for (String source : List.of("WIDTH", "{count + 1}",
+        "{let count = 1usize; count = 2; count}",
+        "{let count = 1usize; {let hidden = 1usize; hidden}; hidden}")) {
+      refused(source);
+    }
+  }
+
+  @Test
+  public void genericClosingTokensRemainSeparateFromConstOperators() {
+    for (String source : List.of(
+        "<std::array::IntoIter<Self, {1 + 1}> as Iterator>::Item",
+        "<std::array::IntoIter<Self, {let count = 1usize; count + 1}> as Iterator>::Item")) {
+      var type = CppRustLiteralMetadata.projectedEntityTypePath(source);
+      assertNotNull(source, type);
+      assertEquals("Self", type.path());
+    }
+  }
+
+  @Test
+  public void bitwiseOperatorsBindBeforeComparisons() {
