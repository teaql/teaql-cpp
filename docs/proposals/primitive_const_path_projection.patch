+package com.skynet.codegenerator.cpp;
+
+import static org.junit.Assert.*;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.zip.GZIPInputStream;
+import org.junit.Test;
+
+public class CppPrimitiveConstPathProjectionTest {
+  private JsonNode fixture() throws Exception {
+    byte[] data;
+    try (InputStream input = getClass().getResourceAsStream("/cpp_primitive_const_paths_5_0_6.json.gz")) {
+      assertNotNull(input);
+      data = input.readAllBytes();
+    }
+    assertEquals("74453da403525f6abd240389ffd96364bb2ab038a3e310a66e5155d786257ec5",
+        HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(data)));
+    try (GZIPInputStream input = new GZIPInputStream(new ByteArrayInputStream(data))) {
+      return new ObjectMapper().readTree(input);
+    }
+  }
+
+  private void model(String name) throws Exception {
+    for (JsonNode row : fixture().get("model_cases")) {
+      if (row.get("name").asText().equals(name)) {
+        var result = CppRustLiteralMetadata.projectedEntityTypePath(row.get("type").asText());
+        if (row.get("accepted").asBoolean()) {
+          assertNotNull(name, result);
+          assertEquals(name, row.get("projected_path").asText(), result.path());
+        } else {
+          assertNull(name, result);
+        }
+        return;
+      }
+    }
+    fail("Missing original model case: " + name);
+  }
+
+  @Test
+  public void integerConstantsKeepTheirWidthsAndResultTypes() throws Exception {
+    for (String kind : List.of("u8", "u16", "u32", "u64", "u128", "usize",
+        "i8", "i16", "i32", "i64", "i128", "isize")) {
+      model("integer_" + kind);
+    }
+  }
+
+  @Test
+  public void floatingConstantsKeepPrecisionAndClassification() throws Exception {
+    model("float_f32");
+    model("float_f64");
+    model("legacy_root_core_float");
+  }
+
+  @Test
+  public void characterConstantsKeepTheirScalarValues() throws Exception {
+    model("character_constants");
+    model("character_missing_bits");
+  }
+
+  @Test
+  public void qualifiedAndRawPathsResolveThePrimitive() throws Exception {
+    for (String name : List.of("std_primitive", "root_std_primitive", "core_primitive",
+        "root_core_primitive", "qualified", "qualified_group", "qualified_root_core",
+        "raw_identifiers", "turbofish_empty", "qualified_empty", "legacy_std",
+        "legacy_core", "legacy_root_std")) {
+      model(name);
+    }
+  }
+
+  @Test
+  public void valueNamesAndModelNamesDoNotReplaceTypePaths() throws Exception {
+    model("value_namespace");
+    model("owner_u8");
+    model("modeled_child");
+  }
+
+  @Test
+  public void resolvedConstantsRetainCheckedArithmeticAndTypeErrors() throws Exception {
+    for (String name : List.of("negative_min_overflow", "usize_add_overflow",
+        "bits_is_not_u8", "unknown_member", "wrong_final_type", "float_char_cast",
+        "legacy_missing_bits")) {
+      model(name);
+    }
+  }
+
+  @Test
+  public void completeConstExpressionMatrixMatchesActualCompiler() throws Exception {
+    JsonNode value = fixture();
+    assertEquals(1, value.get("schema").asInt());
+    assertEquals("fe82a18982415f1746df9a2cf7c42f5e9abdc6d3", value.get("runtime_commit").asText());
+    assertEquals("45e1572c4956ca963410d8ea436ead3c8857087a", value.get("generator_commit").asText());
+    assertEquals("7d1696a7c54c5073cc90a2e8027af9dd1401589c4b942eefd828b79677641103",
+        value.get("source_reference_sha256").asText());
+    assertEquals(928, value.get("cases").size());
+    for (JsonNode row : value.get("cases")) {
+      String expression = row.get("expression").asText();
+      var result = CppRustLiteralMetadata.projectedEntityTypePath(
+          "<[Self; " + expression + "] as IntoIterator>::Item");
+      if (row.get("accepted").asBoolean()) {
+        assertNotNull(expression, result);
+        assertEquals(expression, "Self", result.path());
+      } else {
+        assertNull(expression, result);
+      }
+    }
+  }
+
+  @Test
+  public void everyActualGeneratedModelKeepsItsTypeOutcome() throws Exception {
+    JsonNode value = fixture();
+    assertEquals(61, value.get("model_cases").size());
+    for (JsonNode row : value.get("model_cases")) {
+      model(row.get("name").asText());
+    }
+  }
+  private void expressionCase(String name) throws Exception {
+    for (JsonNode row : fixture().get("cases")) {
+      if (row.has("name") && row.get("name").asText().equals(name)) {
+        String expression = row.get("expression").asText();
+        var result = CppRustLiteralMetadata.projectedEntityTypePath(
+            "<[Self; " + expression + "] as IntoIterator>::Item");
+        if (row.get("accepted").asBoolean()) {
+          assertNotNull(name, result);
+          assertEquals(name, "Self", result.path());
+        } else {
+          assertNull(name, result);
+        }
+        return;
+      }
+    }
+    fail("Missing actual expression case: " + name);
+  }
+
+  @Test
+  public void tupleShapesPatternsAndCopiesRemainDistinctValues() throws Exception {
+    for (String name : List.of("tuple_literal", "tuple_annotation", "tuple_alias_copy",
+        "tuple_nested_mutation", "unicode_destructure", "unicode_rest_suffix",
+        "tuple_mutable_pattern", "tuple_unit_pattern", "tuple_unit_assignment",
+        "tuple_swap_assignment", "tuple_discard_assignment", "tuple_if_bad_shape",
+        "tuple_wrong_arity", "tuple_immutable_field", "tuple_out_of_range",
+        "tuple_scalar_cast", "tuple_const_comparison", "tuple_duplicate_pattern",
+        "tuple_structural_coercion", "tuple_nested_pattern", "tuple_multiple_rest")) {
+      expressionCase(name);
+    }
+  }
+
+  @Test
+  public void primitiveAssignmentsEvaluateTheRightSideBeforeTheirPlaces() throws Exception {
+    for (String name : List.of("tuple_assignment_order", "tuple_compound_order",
+        "tuple_compound_order_primitive", "scalar_compound_self_write",
+        "scalar_compound_clears_overflow", "primitive_order_add", "primitive_order_sub",
+        "primitive_order_mul", "primitive_order_div", "primitive_order_rem",
+        "primitive_order_and", "primitive_order_or", "primitive_order_xor",
+        "primitive_order_ll", "primitive_order_rr")) {
+      expressionCase(name);
+    }
+  }
+
+}
