+package com.skynet.codegenerator.cpp;
+import static org.junit.Assert.*;
+import java.util.List;
+import org.junit.Test;
+
+public class CppContainerTypeProjectionTest {
+  private void entity(String source) {
+    var type = CppRustLiteralMetadata.projectedEntityTypePath(source);
+    assertNotNull(source, type);
+    assertEquals(source, "Self", type.path());
+  }
+
+  @Test
+  public void ownedContainersExposeTheirEntityItems() {
+    for (String source : List.of("<Vec<Self> as IntoIterator>::Item",
+        "<std::vec::Vec<Self> as std::iter::IntoIterator>::Item",
+        "<<Vec<Self> as IntoIterator>::IntoIter as Iterator>::Item",
+        "<Result<Self, ()> as IntoIterator>::Item",
+        "<std::result::IntoIter<Self> as Iterator>::Item")) {
+      entity(source);
+    }
+  }
+
+  @Test
+  public void pointerTargetsRemainSeparateFromPointerWrappers() {
+    for (String source : List.of("<Box<Self> as std::ops::Deref>::Target",
+        "<&Self as core::ops::Deref>::Target", "<&'static Self as std::ops::Deref>::Target",
+        "<&mut Self as std::ops::Deref>::Target")) {
+      entity(source);
+    }
+  }
+
+  @Test
+  public void nestedContainersPreserveEachProjectionStep() {
+    for (String source : List.of(
+        "<<Vec<Option<Self>> as IntoIterator>::Item as IntoIterator>::Item",
+        "<<Box<Option<Self>> as std::ops::Deref>::Target as IntoIterator>::Item",
+        "<<<Vec<Self> as std::ops::Deref>::Target as ToOwned>::Owned as IntoIterator>::Item",
+        "<<<&Vec<Self> as IntoIterator>::IntoIter as Iterator>::Item as std::ops::Deref>::Target")) {
+      entity(source);
+    }
+  }
+
+  @Test
+  public void erasedContainersRetainPreludeIdentityRequirements() {
+    assertEquals(List.of("Vec", "IntoIterator"),
+        CppRustLiteralMetadata.projectedEntityTypePath("<Vec<Self> as IntoIterator>::Item").preludeNames());
+    assertEquals(List.of("Result", "IntoIterator"),
+        CppRustLiteralMetadata.projectedEntityTypePath("<Result<Self, ()> as IntoIterator>::Item").preludeNames());
+    assertEquals(List.of("Box"),
+        CppRustLiteralMetadata.projectedEntityTypePath("<Box<Self> as std::ops::Deref>::Target").preludeNames());
+  }
+
+  @Test
+  public void wrappersAndUnsupportedTraitStepsDoNotBecomeEntities() {
+    for (String source : List.of("Vec<Self>", "Box<Self>", "&Self", "Result<Self, ()>",
+        "<Vec<Self> as Iterator>::Item", "<Box<Self> as IntoIterator>::Item",
+        "<Vec<Self> as std::ops::Deref>::Target",
+        "<<&mut Self as ToOwned>::Owned as std::ops::Deref>::Target")) {
+      assertNull(source, CppRustLiteralMetadata.projectedEntityTypePath(source));
+    }
+  }
+
+  @Test
+  public void unboundReferenceLifetimesDoNotResolve() {
+    entity("<&'static Self as std::ops::Deref>::Target");
+    entity("<&'_ Self as std::ops::Deref>::Target");
+    for (String source : List.of("<&'a Self as std::ops::Deref>::Target",
+        "<&'missing Self as std::ops::Deref>::Target",
+        "<<Box<&'missing Self> as std::ops::Deref>::Target as std::ops::Deref>::Target",
+        "<&'a mut Self as std::ops::Deref>::Target")) {
+      assertNull(source, CppRustLiteralMetadata.projectedEntityTypePath(source));
+    }
+  }
+}
