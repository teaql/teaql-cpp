+package com.skynet.codegenerator.cpp;
+
+import static org.junit.Assert.*;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.ByteArrayInputStream;
+import java.io.InputStream;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.zip.GZIPInputStream;
+import org.junit.Test;
+
+public class CppScalarConstValueProjectionTest {
+  private void length(String source) {
+    var type = CppRustLiteralMetadata.projectedEntityTypePath(
+        "<[Self; " + source + "] as IntoIterator>::Item");
+    assertNotNull(source, type);
+    assertEquals(source, "Self", type.path());
+  }
+
+  private void refused(String source) {
+    assertNull(source, CppRustLiteralMetadata.projectedEntityTypePath(
+        "<[Self; " + source + "] as IntoIterator>::Item"));
+  }
+
+  @Test
+  public void characterLiteralsRetainUnicodeAndByteValues() {
+    for (String source : List.of("'A' as usize",
+        "'é' as usize",
+        "'\\u{1f680}' as usize",
+        "b'A' as usize",
+        "b'\\xff' as usize",
+        "'\"' as usize",
+        "'\\'' as usize")) {
+      length(source);
+    }
+  }
+  @Test
+  public void characterCastsRetainTheirTypeRestrictions() {
+    for (String source : List.of("{let mark: char = 'A'; mark as usize}",
+        "(65 as char) as usize",
+        "('A' as char) as usize",
+        "{if ('é' as usize) == 233 {2} else {1 / 0}}")) {
+      length(source);
+    }
+    for (String source : List.of("(65u32 as char) as usize",
+        "('A' + 'B') as usize",
+        "(-'A') as usize",
+        "('A' as f64) as usize",
+        "'A'")) {
+      refused(source);
+    }
+  }
+  @Test
+  public void floatingLiteralsRetainContextualInference() {
+    for (String source : List.of("1.75f64 as usize",
+        "(1.5f32 + 0.5f32) as usize",
+        "(1.25 + 0.75) as usize",
+        "2f32 as usize",
+        "{let value: f32 = 1.0000000596046447753906250000000001; if value > 1.0f32 {2} else {1 / 0}}")) {
+      length(source);
+    }
+  }
+  @Test
+  public void floatingArithmeticRetainsItsOwnPrecision() {
+    for (String source : List.of("{if (16777216.0f32 + 1.0f32) == 16777216.0f32 {2} else {1 / 0}}",
+        "{if (9007199254740992.0f64 + 1.0f64) == 9007199254740992.0f64 {2} else {1 / 0}}",
+        "{if ((16777217u32 as f32) as u32) == 16777216u32 {2} else {1 / 0}}",
+        "{if ((16777217.0f64 as f32) as u32) == 16777216u32 {2} else {1 / 0}}",
+        "{if (18446744073709549568.0f64 as u128) == 18446744073709549568u128 {2} else {1 / 0}}")) {
+      length(source);
+    }
+  }
+  @Test
+  public void floatingCastsSaturateAndTruncate() {
+    for (String source : List.of("{if ((-1.5f64) as u8) == 0u8 {2} else {1 / 0}}",
+        "{if ((1.0f64 / 0.0f64) as u8) == 255u8 {2} else {1 / 0}}",
+        "{if ((-1.0f64 / 0.0f64) as i8) == -128i8 {2} else {1 / 0}}",
+        "{if ((0.0f64 / 0.0f64) as usize) == 0 {2} else {1 / 0}}",
+        "{let value = 0.0f64 / 0.0f64; if value != value {2} else {1 / 0}}",
+        "{if -0.0f64 == 0.0f64 {2} else {1 / 0}}",
+        "{let mut value = 1.0f32; value += 1.0f32; value as usize}")) {
+      length(source);
+    }
+  }
+  @Test
+  public void floatingTypesRejectIllegalOperations() {
+    for (String source : List.of("1.0f64",
+        "(1.0f64 & 1.0f64) as usize",
+        "(true as f64) as usize",
+        "(65.0f64 as char) as usize",
+        "(1.0f32 + 1.0f64) as usize",
+        "1.0F64 as usize")) {
+      refused(source);
+    }
+  }
+  @Test
+  public void identityAndUnitCastsRetainConstSemantics() {
+    for (String source : List.of("(true as bool) as usize",
+        "{let value = () as (); 1usize}",
+        "{let mut value = (); value = (); 1usize}")) {
+      length(source);
+    }
+    for (String source : List.of("{if () == () {1usize} else {2usize}}",
+        "{if () < () {1usize} else {2usize}}")) {
+      refused(source);
+    }
+  }
+  @Test
+  public void completePrimitiveCastMatrixMatchesTheCompiler() throws Exception {
+    byte[] data;
+    try (InputStream input = getClass().getResourceAsStream("/cpp_scalar_const_casts_5_0_6.json.gz")) {
+      assertNotNull(input);
+      data = input.readAllBytes();
+    }
+    assertEquals("0e3cba36376997c27927d8bc2e4b9111ef9ed39e9620d835b9073bfb90007bb3",
+        HexFormat.of().formatHex(MessageDigest.getInstance("SHA-256").digest(data)));
+    JsonNode value;
+    try (GZIPInputStream input = new GZIPInputStream(new ByteArrayInputStream(data))) {
+      value = new ObjectMapper().readTree(input);
+    }
+    assertEquals(1, value.get("schema").asInt());
+    assertEquals("fe82a18982415f1746df9a2cf7c42f5e9abdc6d3", value.get("runtime_commit").asText());
+    assertEquals("45e1572c4956ca963410d8ea436ead3c8857087a", value.get("generator_commit").asText());
+    assertEquals("34991adc391729df5ee76ede2eff25167038efb05c515ecef36361d7f75748d3", value.get("source_reference_sha256").asText());
+    assertEquals(294, value.get("cases").size());
+    for (JsonNode row : value.get("cases")) {
+      String expression = row.get("expression").asText();
+      if (row.get("accepted").asBoolean()) {
+        length(expression);
+      } else {
+        refused(expression);
+      }
+    }
+  }
+  @Test
+  public void derivedContextRetainsItsLiteralRepresentation() {
+    for (String source : List.of("(256 as char) as usize",
+        "1e400f64 as usize",
+        "18446744073709551616usize",
+        "{if ((256 as char) as usize) == 0 {1} else {1 / 0}}",
+        "{if (256u8 as usize) == 0 {1} else {1 / 0}}",
+        "{if 128i8 == -128i8 {1} else {1 / 0}}",
+        "{if 18446744073709551616usize == 0usize {1} else {1 / 0}}",
+        "{if true {1usize} else {1e400f64 as usize}}",
+        "{if -384i8 == -128i8 {2} else {1 / 0}}",
+        "{if -129i8 == 127i8 {2} else {1 / 0}}")) {
+      length(source);
+    }
+    refused("340282366920938463463374607431768211456u128 as usize");
+  }
+}
